{
  "name": "casa-guell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix --fix-suggestions",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "check": "pnpm run lint && pnpm run typecheck",
    "check:fast": "pnpm run check && node scripts/floor-guard.mjs",
    "check:task": "pnpm run check && pnpm run test && pnpm run test:build && node scripts/floor-guard.mjs",
    "check:full": "pnpm run check && pnpm run test && pnpm run test:build && node scripts/check-runtime.mjs && node scripts/floor-guard.mjs",
    "check:prod": "node scripts/check-runtime.mjs --url https://casa-guell-drab.vercel.app",
    "test": "vitest run tests/unit tests/guard",
    "test:build": "pnpm run build && vitest run tests/build",
    "preview": "vite preview",
    "bones:build": "boneyard-js build",
    "bones:setup": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "boneyard-js": "^1.10.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "lighthouse": "^13.5.0",
    "oxlint": "^1.81.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}