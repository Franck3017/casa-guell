{
  "name": "casa-guell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix --fix-suggestions",
